<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!-- ===================== -->
    <!-- Register Servlet -->
    <!-- ===================== -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>Webdev.RegisterServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/Register</url-pattern>
    </servlet-mapping>

    <!-- ===================== -->
    <!-- Login Servlet -->
    <!-- ===================== -->
    <servlet>
        <servlet-name>Loginservlet</servlet-name>
        <servlet-class>Webdev.Loginservlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>Loginservlet</servlet-name>
        <url-pattern>/Login</url-pattern>
    </servlet-mapping>

    <!-- ===================== -->
    <!-- Forgot Password Servlet -->
    <!-- ===================== -->
    <servlet>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <servlet-class>Webdev.ForgotPasswordServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <url-pattern>/ForgotPassword</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>dynamicfetch</servlet-name>
        <servlet-class>Webdev.dynamicfetch</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>dynamicfetch</servlet-name>
        <url-pattern>/dynamicfetch</url-pattern>
    </servlet-mapping>
    

    <!-- ===================== -->
    <!-- Welcome file -->
    <!-- ===================== -->
    <welcome-file-list>
        <welcome-file>login.html</welcome-file>
    </welcome-file-list>

</web-app>
